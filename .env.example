# HuggingFace token — necesario para descargar pyannote/speaker-diarization-3.1
# Generar en https://huggingface.co/settings/tokens (read-only alcanza)
# IMPORTANTE: aceptar términos del modelo en https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Directorio donde se cachean los modelos descargados (mounted como volumen Docker)
DATA_DIR=/data

# Idioma por defecto (ISO 639-1)
DEFAULT_LANGUAGE=es

# Whisper compute type: float16 (recomendado en 16 GB VRAM), int8 (si VRAM ajustada), float32 (max calidad, requiere 24+ GB)
COMPUTE_TYPE=float16

# Tamaño máximo de upload en MB (rechaza requests más grandes con 413)
MAX_UPLOAD_MB=500

# Timeout del pipeline en segundos
PIPELINE_TIMEOUT_SECONDS=1800

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
