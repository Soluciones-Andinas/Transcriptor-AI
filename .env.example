# ============================================================================
# transcription-api — environment variables
# Copia este archivo a .env y completa los valores. NO commitear .env.
# ============================================================================

# ----------------------------------------------------------------------------
# Pipeline IA (Capa 4+)
# ----------------------------------------------------------------------------

# HuggingFace token — necesario para descargar pyannote/speaker-diarization-3.1
# Generar en https://huggingface.co/settings/tokens (read-only alcanza)
# IMPORTANTE: aceptar términos del modelo en https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Directorio raíz de datos (modelos pre-descargados, caché efímero, uploads, blobs).
# En Docker: mounted como volumen al path /data.
DATA_DIR=/data

# Idioma por defecto (ISO 639-1)
DEFAULT_LANGUAGE=es

# Whisper compute type: float16 (recomendado en 16 GB VRAM), int8 (si VRAM ajustada), float32 (max calidad, requiere 24+ GB)
COMPUTE_TYPE=float16

# Tamaño máximo de upload en MB para audio (rechaza requests más grandes con 413)
MAX_UPLOAD_MB=500

# Tamaño máximo de upload en MB para imágenes
MAX_IMAGE_UPLOAD_MB=25

# Timeout del pipeline en segundos
PIPELINE_TIMEOUT_SECONDS=1800

# ----------------------------------------------------------------------------
# Persistencia — PostgreSQL (Capa 1)
# Ver wiki/ADR/ADR-008.md y wiki/05_modelo_datos.md
# ----------------------------------------------------------------------------

# Credenciales y nombre de base
POSTGRES_USER=transcription
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=transcription_api

# Host y puerto. En docker-compose el host es el nombre del servicio: "postgres".
# En desarrollo local fuera de compose, usar "localhost".
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Driver SQLAlchemy + asyncpg. Composeable desde las variables de arriba al
# inicializar el engine. Esta variable opcional permite override directo.
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Tamaño del pool de conexiones (asyncpg)
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5

# ----------------------------------------------------------------------------
# Autenticación — Microsoft Entra ID OAuth 2.0 / OIDC (Capa 2)
# Ver wiki/ADR/ADR-009.md
# ----------------------------------------------------------------------------

# Registrá la app en Azure Portal y completá:
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/auth/callback

# Clave para encriptar refresh tokens de MS antes de persistir.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_TOKEN_ENC_KEY=

# Clave para firmar el JWT de la cookie de sesión web.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# TTL de la cookie de sesión web (segundos). Default 24 h.
SESSION_TTL_SECONDS=86400

# ----------------------------------------------------------------------------
# Caché filesystem y cleanup (Capa 4 + RFs CACHE-*)
# ----------------------------------------------------------------------------

# TTL del caché efímero en filesystem (segundos). Default 24 h.
CACHE_TTL_SECONDS=86400

# Intervalo del cleanup job en segundos. Default 1 h.
CACHE_CLEANUP_INTERVAL_SECONDS=3600

# Grace period extra antes de marcar upload_sessions como expired (segundos).
UPLOAD_SESSION_GRACE_SECONDS=300

# ----------------------------------------------------------------------------
# Concurrencia (ADR-005)
# ----------------------------------------------------------------------------

# Tiempo de espera para adquirir el lock global (segundos)
LOCK_WAIT_SECONDS=5

# Header Retry-After cuando el lock está ocupado (segundos)
LOCK_RETRY_AFTER_SECONDS=600

# ----------------------------------------------------------------------------
# Observabilidad
# ----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
