# Excluir todo lo que no necesita ir a la imagen.
# Reduce build context y previene leak de secretos.

# VCS
.git
.gitignore
.github

# Documentación y wiki (no se necesita en runtime; son fuente de verdad pero no código)
docs/
wiki/
README.md
AGENTS.md
CLAUDE.md
*.md

# Configuración local
.env
.env.local
.env.*.local
.mcp.json

# Outputs de herramientas
graphify-out/
.claude/
.serena/

# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
tests/fixtures/audio/

# Volúmenes locales (estos los monta docker-compose)
data/

# Logs
*.log
